<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>

          <!-- ���������� �������� ����� -->
          <Include>
            <ModulePath>.*NetSdrClientApp.dll$</ModulePath>
          </Include>

          <Exclude>
            <Attribute>ExcludeFromCodeCoverageAttribute</Attribute>
            <ClassName>^AutoGenerated.*</ClassName>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
